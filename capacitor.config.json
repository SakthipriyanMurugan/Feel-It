{
  "appId": "com.sakthi.feelit",
  "appName": "FEEL IT",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://feelit.feelit.workers.dev",
    "cleartext": true,
    "allowNavigation": [
      "feelit.feelit.workers.dev",
      "*.workers.dev",
      "*.backblazeb2.com",
      "coverartarchive.org",
      "*.coverartarchive.org",
      "archive.org",
      "*.archive.org",
      "musicbrainz.org"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  },
  "android": {
    "backgroundColor": "#050507",
    "allowMixedContent": true
  }
}